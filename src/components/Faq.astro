---
// Native <details> keeps answers in the HTML for crawlers while staying compact for readers.
interface Props { faqs: { q: string; a: string }[]; heading?: string }
const { faqs, heading = 'Common questions' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="prose" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{heading}</h2>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
