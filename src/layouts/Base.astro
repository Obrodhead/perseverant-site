---
import '../styles/global.css';
import { site, nav } from '../site.config';
import { activeServices, activeIndustries } from '../lib/content';
import { quoteFor } from '../lib/quotes';

interface Props {
  title: string;
  description: string;
  schema?: object;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, schema, ogType = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const services = await activeServices();
const industries = await activeIndustries();
const year = new Date().getFullYear();
const quote = quoteFor(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Schibsted+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6RMHPXYY9K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6RMHPXYY9K');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <svg width="36" height="25" viewBox="0 10 64 44" aria-hidden="true">
            <path d="M20 44A12 12 0 0 1 44 44M12 44A20 20 0 0 1 52 44M4 44A28 28 0 0 1 60 44" fill="none" stroke="#24503f" stroke-width="4.5" stroke-linecap="round" />
            <circle cx="32" cy="44" r="5" fill="#a8812c" />
          </svg>
          {site.name}
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>Services</h2>
            <ul>
              {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Industries</h2>
            <ul>
              {industries.map((s) => <li><a href={`/industries/${s.id}/`}>{s.data.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Company</h2>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              <li>{site.email}</li>
              <li>{site.location.city}, {site.location.region}</li>
            </ul>
          </div>
        </div>
        <blockquote class="quote">
          “{quote.text}”
          <cite>{quote.author}, {quote.source}</cite>
        </blockquote>
        <p class="fineprint">© {year} {site.legalName}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
