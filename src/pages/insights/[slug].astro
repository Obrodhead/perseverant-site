---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShortAnswer from '../../components/ShortAnswer.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import GuideOffer from '../../components/GuideOffer.astro';
import GuidePicker from '../../components/GuidePicker.astro';
import { site } from '../../site.config';
import { publishedInsights, activeIndustries, isoDate, displayDate } from '../../lib/content';
import { graph, breadcrumbs, faqPage, ORG_ID, PERSON_ID } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await publishedInsights();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/insights/${entry.id}/`;
const updated = d.updated ?? d.published;
// A post can end with one industry guide's offer and request form.
const guide = d.guide ? await getEntry('guides', d.guide) : undefined;
const activeGuide = guide && guide.data.status === 'active' ? guide : undefined;
const guideIndustry = activeGuide ? await getEntry('industries', activeGuide.data.industry) : undefined;
const allIndustries = activeGuide ? [] : await activeIndustries();

const schema = graph(
  {
    '@type': 'BlogPosting',
    '@id': `${site.url}${path}#article`,
    headline: d.title,
    description: d.description,
    abstract: d.answer,
    datePublished: isoDate(d.published),
    dateModified: isoDate(updated),
    author: { '@id': PERSON_ID },
    publisher: { '@id': ORG_ID },
    mainEntityOfPage: `${site.url}${path}`,
    keywords: d.tags.join(', '),
    isPartOf: { '@id': `${site.url}/insights/#blog` },
    inLanguage: 'en-US',
  },
  faqPage(d.faqs, path),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/insights/' },
    { name: d.title, path },
  ]),
);
---
<Base title={d.title} description={d.description} schema={schema} ogType="article">
  <div class="container narrow">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / <a href="/insights/">Insights</a></p>
      <h1>{d.title}</h1>
      <p class="meta">
        By <a href="/about/">{site.founder.name}</a> · Published <time datetime={isoDate(d.published)}>{displayDate(d.published)}</time>
      </p>
    </header>
    <article class="prose" style="padding-bottom: 72px;">
      <ShortAnswer text={d.answer} updated={updated} />
      <Content />
      <Faq faqs={d.faqs} />
      {activeGuide
        ? <GuideOffer guide={activeGuide} page={path} industryLabel={guideIndustry?.data.label ?? ''} />
        : <GuidePicker industries={allIndustries} variant="inline" />}
    </article>
  </div>
  {activeGuide
    ? <CtaBand heading={activeGuide.data.title} text={activeGuide.data.hook} href="#guide" label="Get the free guide" />
    : <CtaBand />}
</Base>
