---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import { publishedInsights, displayDate, isoDate } from '../../lib/content';
import { graph, breadcrumbs, ORG_ID, PERSON_ID } from '../../lib/schema';

const posts = await publishedInsights();
const description = 'Straight answers on marketing for financial advisors: AI search, SEO, paid social, events, automation and compliance.';
const schema = graph(
  {
    '@type': 'Blog',
    '@id': `${site.url}/insights/#blog`,
    url: `${site.url}/insights/`,
    name: `${site.name} Insights`,
    publisher: { '@id': ORG_ID },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${site.url}/insights/${p.id}/`,
      datePublished: isoDate(p.data.published),
      author: { '@id': PERSON_ID },
    })),
  },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights/' }]),
);
---
<Base title="Insights" description={description} schema={schema}>
  <div class="container narrow">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / Insights</p>
      <h1>Insights</h1>
      <p style="color: var(--muted); font-size: var(--step-1); max-width: 52ch;">Question-led articles for advisors who want marketing that works and stays compliant.</p>
    </header>
    <ul class="post-list" style="margin-bottom: 80px;">
      {posts.map((p) => (
        <li>
          <a href={`/insights/${p.id}/`}>
            <time datetime={isoDate(p.data.published)}>{displayDate(p.data.published)}</time>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
