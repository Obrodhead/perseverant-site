---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceStages from '../../components/ServiceStages.astro';
import { site } from '../../site.config';
import { activeServices } from '../../lib/content';
import { graph, breadcrumbs, ORG_ID } from '../../lib/schema';

const services = await activeServices();
const description = 'Lead generation services: AI search visibility, SEO, Meta lead ads, seminars and webinars, CRM follow-up and custom tools, measured by booked appointments.';
const schema = graph(
  {
    '@type': 'ItemList',
    name: `${site.name} services`,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site.url}/services/${s.id}/`,
      name: s.data.title,
    })),
  },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]),
  { '@type': 'CollectionPage', url: `${site.url}/services/`, name: 'Services', isPartOf: { '@id': `${site.url}/#website` }, about: { '@id': ORG_ID } },
);
---
<Base title="Lead Generation Services" description={description} schema={schema}>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / Services</p>
      <p class="eyebrow">Services</p>
      <h1>Grassroots growth that draws your people, sharpened by precise paid media</h1>
      <p class="lede" style="color: var(--muted); font-size: var(--step-1); max-width: 56ch;">The foundation is earned: clear answers in Google and AI search, a strong local presence, events and follow-up that feel human. Paid media then reaches the right people at the right moment. Start with the piece that closes your biggest gap, and measure everything by booked appointments.</p>
    </header>
    <div style="margin-bottom: 72px;"><ServiceStages level={2} /></div>
  </div>
  <CtaBand />
</Base>
