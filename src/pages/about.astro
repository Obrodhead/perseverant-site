---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config';
import { graph, person, breadcrumbs, ORG_ID, PERSON_ID } from '../lib/schema';

const description = `About ${site.name}: a Cleveland-based marketing firm for financial advisors, founded by ${site.founder.name}.`;
const schema = graph(
  { '@type': 'AboutPage', url: `${site.url}/about/`, name: `About ${site.name}`, about: { '@id': ORG_ID }, mainEntity: { '@id': PERSON_ID } },
  person(),
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]),
);
---
<Base title="About" description={description} schema={schema}>
  <div class="container narrow">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / About</p>
      <h1>Marketing that keeps going after the launch.</h1>
    </header>
    <article class="prose" style="padding-bottom: 72px;">
      <!-- TODO (Owen): edit this in your own voice before launch. -->
      <p>
        {site.name} was founded in {site.founded} by {site.founder.name}, who leads paid media and organic SEO
        for financial advisory firms. He has run ads and content for as many as 15 accounts at once, built
        seminar and webinar campaigns that convert attendees into clients, and set up the automation that
        keeps follow-up consistent.
      </p>
      <p>
        Before focusing on advisors, he helped ecommerce brands grow on Shopify and Amazon. He also holds a
        full stack web development certificate, which is why this firm builds its own pages, workflows and
        tools instead of handing them off.
      </p>

      <h2>Why "Perseverant"</h2>
      <p>
        Good marketing for advisors compounds. SEO pages gain trust over months, a campaign improves with
        every test, and a referral network grows one relationship at a time. The name is a reminder that
        results come from steady, intentional work rather than one big push.
      </p>
      <p>
        It also borrows from Henry David Thoreau, who wrote that he had great faith in a seed and was prepared
        to expect wonders from one. Every client engagement starts as a seed.
      </p>

      <h2>Where we work</h2>
      <p>
        We are based in {site.location.city}, Ohio, and work with advisory firms across the {site.areaServed}.
      </p>
    </article>
  </div>
  <CtaBand />
</Base>
