---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <div class="container narrow">
    <header class="page-head" style="padding-bottom: 96px;">
      <p class="eyebrow">404</p>
      <h1>This page isn't here.</h1>
      <p style="color: var(--muted);">It may have moved. Try the <a href="/services/">services</a>, the <a href="/insights/">insights</a> or the <a href="/">home page</a>.</p>
    </header>
  </div>
</Base>
