---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../site.config';
import { activeIndustries } from '../../lib/content';
import { graph, breadcrumbs, ORG_ID } from '../../lib/schema';

const industries = await activeIndustries();
// Grouped industries first (in order of first appearance), then everything ungrouped.
const groupNames = [...new Set(industries.map((s) => s.data.group).filter((g): g is string => Boolean(g)))];
const sections = [
  ...groupNames.map((name) => ({ name, items: industries.filter((s) => s.data.group === name) })),
  { name: groupNames.length ? 'More industries we serve' : '', items: industries.filter((s) => !s.data.group) },
].filter((g) => g.items.length > 0);
const description = 'Industries we serve: home improvement and industrial contractors, law firms, elective healthcare, senior living and home care, recruiting and staffing, and estate security firms.';
const schema = graph(
  {
    '@type': 'CollectionPage',
    url: `${site.url}/industries/`,
    name: 'Industries',
    about: { '@id': ORG_ID },
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'ItemList',
    name: `Industries served by ${site.name}`,
    itemListElement: industries.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/industries/${s.id}/`, name: s.data.title })),
  },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }]),
);
---
<Base title="Industries We Serve" description={description} schema={schema}>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / Industries</p>
      <p class="eyebrow">Industries we serve</p>
      <h1>Careful decisions start with research</h1>
      <p style="color: var(--muted); font-size: var(--step-1); max-width: 56ch;">Your clients don't hire on impulse. They take their time, asking Google and AI assistants detailed questions before they ever reach out. We help them understand who you are and why you fit, so the first conversation starts with trust.</p>
    </header>
    {sections.map((g) => (
      <section style="margin-bottom: 56px;">
        {g.name && <h2 class="eyebrow" style="margin-bottom: 16px;">{g.name}</h2>}
        <ul class="service-grid">
          {g.items.map((s) => (
            <li>
              <a href={`/industries/${s.id}/`}>
                <span class="num">{s.data.examples.slice(0, 3).join(' · ')}</span>
                <h3>{s.data.label}</h3>
                <p>{s.data.summary}</p>
                <span class="more">Learn more <span class="arr" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <CtaBand />
</Base>
