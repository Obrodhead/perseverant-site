---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../site.config';
import { activeIndustries } from '../../lib/content';
import { graph, breadcrumbs, ORG_ID } from '../../lib/schema';

const industries = await activeIndustries();
const description = 'Industries we serve: law firms, elective healthcare, home improvement, senior living and home care, recruiting and staffing, and estate security firms.';
const schema = graph(
  {
    '@type': 'CollectionPage',
    url: `${site.url}/industries/`,
    name: 'Industries',
    about: { '@id': ORG_ID },
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'ItemList',
    name: `Industries served by ${site.name}`,
    itemListElement: industries.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/industries/${s.id}/`, name: s.data.title })),
  },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }]),
);
---
<Base title="Industries We Serve" description={description} schema={schema}>
  <div class="container">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / Industries</p>
      <p class="eyebrow">Industries we serve</p>
      <h1>Understood before the first call.</h1>
      <p style="color: var(--muted); font-size: var(--step-1); max-width: 56ch;">Choosing a lawyer, a surgeon, a roofer or a parent's care home is a careful decision. People research for weeks and ask Google and AI assistants detailed questions before they reach out. We help them understand who you are and why you fit, so the first conversation starts with trust.</p>
    </header>
    <ul class="service-grid" style="margin-bottom: 72px;">
      {industries.map((s) => (
        <li>
          <a href={`/industries/${s.id}/`}>
            <span class="num">{s.data.examples.slice(0, 3).join(' · ')}</span>
            <h2 style="font-size: 1.2rem;">{s.data.label}</h2>
            <p>{s.data.summary}</p>
            <span class="more">Learn more →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <CtaBand />
</Base>
