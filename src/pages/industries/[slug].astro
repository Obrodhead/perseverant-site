---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShortAnswer from '../../components/ShortAnswer.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../site.config';
import { activeIndustries, activeLocations, placeSlug, isoDate } from '../../lib/content';
import { graph, breadcrumbs, faqPage, ORG_ID } from '../../lib/schema';

export async function getStaticPaths() {
  const industries = await activeIndustries();
  return industries.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: industries.filter((s) => s.id !== entry.id) } }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/industries/${entry.id}/`;
const services = (await Promise.all(d.services.map((id) => getEntry('services', id))))
  .filter((s): s is NonNullable<typeof s> => Boolean(s) && s!.data.status === 'active');
const markets = await activeLocations(entry.id);

const schema = graph(
  {
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: d.title,
    description: d.answer,
    serviceType: 'Lead generation',
    provider: { '@id': ORG_ID },
    areaServed: { '@type': 'Country', name: site.areaServed },
    audience: { '@type': 'BusinessAudience', name: d.label, audienceType: d.examples.join(', ') },
    url: `${site.url}${path}`,
  },
  {
    '@type': 'WebPage',
    '@id': `${site.url}${path}`,
    url: `${site.url}${path}`,
    name: d.title,
    description: d.summary,
    dateModified: isoDate(d.updated),
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}${path}#service` },
  },
  faqPage(d.faqs, path),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/industries/' },
    { name: d.label, path },
  ]),
);
---
<Base title={d.title} description={d.summary} schema={schema}>
  <div class="container">
    <header class="page-head narrow" style="padding-inline: 0;">
      <p class="crumbs"><a href="/">Home</a> / <a href="/industries/">Industries</a></p>
      <h1>{d.title}</h1>
    </header>
    <div class="split">
      <article class="prose">
        <ShortAnswer text={d.answer} updated={d.updated} />
        <Content />
        <Faq faqs={d.faqs} />
      </article>
      <aside class="aside">
        <div class="aside-box">
          <h2>Who we work with</h2>
          <ul>{d.examples.map((x) => <li>{x}</li>)}</ul>
        </div>
        {services.length > 0 && (
          <div class="aside-box">
            <h2>Services that fit</h2>
            <ul>{services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}</ul>
          </div>
        )}
        {markets.length > 0 && (
          <div class="aside-box">
            <h2>Local markets</h2>
            <ul>{markets.map((m) => <li><a href={`${path}${placeSlug(m.id)}/`}>{m.data.label}</a></li>)}</ul>
          </div>
        )}
        <div class="aside-box">
          <h2>Other industries</h2>
          <ul>{others.map((o) => <li><a href={`/industries/${o.id}/`}>{o.data.label}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </div>
  <CtaBand />
</Base>
