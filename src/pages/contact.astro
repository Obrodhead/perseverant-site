---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import LeadForm from '../components/LeadForm.astro';
import { graph, breadcrumbs, ORG_ID } from '../lib/schema';

const description = `Contact ${site.name} about lead generation for your business.`;
const schema = graph(
  { '@type': 'ContactPage', url: `${site.url}/contact/`, name: `Contact ${site.name}`, about: { '@id': ORG_ID } },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]),
);
---
<Base title="Contact" description={description} schema={schema}>
  <div class="container narrow">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / Contact</p>
      <h1>Let's talk about your business</h1>
    </header>
    <div class="prose" style="padding-bottom: 88px;">
      <p>
        Tell us about your business, who you serve and what you want more of. We reply within one
        business day, usually with times for a free {site.leads.callMinutes}-minute exploration call.
      </p>
      <LeadForm
        kind="contact"
        formId="contact"
        formLabel={`${site.leads.callMinutes}-minute exploration call (contact page)`}
        page="/contact/"
        redirect="/thanks/"
        submitLabel={`Request a ${site.leads.callMinutes}-minute call`}
      />
      <div class="aside-box">
        <h2>Prefer email?</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      {site.bookingUrl && (
        <p><a class="btn btn-primary" href={site.bookingUrl}>Book a call</a></p>
      )}
      <p style="color: var(--muted);">Based in {site.location.city}, {site.location.region}. Working with businesses nationwide.</p>
    </div>
  </div>
</Base>
