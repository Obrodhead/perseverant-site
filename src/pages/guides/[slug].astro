---
// Full lead magnet guide. Visitors land here after the guide form on a service page.
// noindex and left out of the sitemap and llms.txt, so the offer stays the way in.
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShortAnswer from '../../components/ShortAnswer.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../site.config';
import { activeGuides } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await activeGuides();
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const g = entry.data;
const path = `/guides/${entry.id}/`;
const service = await getEntry('services', g.service);
const mins = site.leads.callMinutes;
---
<Base title={g.title} description={g.summary} noindex>
  <div class="container narrow guide">
    <header class="page-head">
      <p class="crumbs">
        <a href="/">Home</a> / {service ? <a href={`/services/${service.id}/`}>{service.data.title}</a> : 'Guides'} / Guide
      </p>
      <p class="eyebrow">A field guide from {site.name}</p>
      <h1>{g.title}</h1>
      <p class="guide-lede">{g.hook}</p>
      <p class="guide-tools no-print">
        Bookmark this page to come back to it. To save a copy, use your browser's Print and choose Save as PDF.
      </p>
    </header>

    <article class="prose guide-body">
      <ShortAnswer text={g.answer} updated={g.updated} />
      <Content />
    </article>

    <section class="guide-call no-print" id="call" aria-labelledby="call-h">
      <p class="eyebrow">Free · {mins} minutes · No pitch deck</p>
      <h2 id="call-h">Want a second set of eyes on what you found?</h2>
      <p>
        This guide gets you most of the way. The last stretch usually takes tools, data and repetition.
        In a {mins}-minute exploration call we will:
      </p>
      <ul>{g.callAgenda.map((x) => <li>{x}</li>)}</ul>
      <p>If we are not the right fit, we will say so and point you somewhere better.</p>
      {site.bookingUrl && <p><a class="btn btn-primary" href={site.bookingUrl}>Pick a time</a></p>}
      <LeadForm
        kind="call"
        formId={`call:${entry.id}`}
        formLabel={`${mins}-minute exploration call from ${g.title}`}
        page={path}
        redirect="/thanks/"
        submitLabel={`Request my ${mins}-minute call`}
      />
    </section>
  </div>
</Base>
