---
import GuideView from '../../../components/GuideView.astro';
import { activeGuides } from '../../../lib/content';

export async function getStaticPaths() {
  return (await activeGuides()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<GuideView entry={entry} />
