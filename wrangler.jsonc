// Cloudflare Worker config: serve the static Astro build. Without this file,
// `npx wrangler deploy` tries to auto-convert the project and fails.
// worker/index.js runs first on every request to redirect the trailing-dot hostname
// (perseverantdigital.com.) to perseverantdigital.com, then hands off to the static assets.
{
  "name": "perseverant-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
